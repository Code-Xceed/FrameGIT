{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrameGitConfig",
  "description": "Configuration schema for FrameGit version control system",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "storage": {
      "type": "object",
      "properties": {
        "hashAlgorithm": {
          "type": "string",
          "enum": ["blake2s256", "sha256"],
          "default": "blake2s256"
        },
        "chunkMinSize": {
          "type": "integer",
          "default": 262144
        },
        "chunkTargetSize": {
          "type": "integer",
          "default": 1048576
        },
        "chunkMaxSize": {
          "type": "integer",
          "default": 4194304
        }
      }
    },
    "cloud": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["r2", "s3", "minio", "b2"],
          "default": "r2"
        },
        "endpoint": { "type": "string" },
        "bucket": { "type": "string" },
        "region": { "type": "string", "default": "auto" },
        "accessKeyId": { "type": "string" },
        "secretAccessKey": { "type": "string" },
        "isMock": { "type": "boolean", "default": false }
      }
    },
    "github": {
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "defaultOrg": { "type": "string" },
        "metadataRepo": { "type": "string" },
        "isMock": { "type": "boolean", "default": false }
      }
    },
    "daemon": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "default": 41793 },
        "host": { "type": "string", "default": "127.0.0.1" }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "defaultBranch": { "type": "string", "default": "main" },
        "assetDirectories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ignorePatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "databaseFilename": { "type": "string", "default": "state.db" }
      }
    },
    "user": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "editor": {
      "type": "object",
      "properties": {
        "ticksPerSecond": {
          "type": "object",
          "properties": {
            "premiere": { "type": "integer", "default": 254016000000 },
            "resolve": { "type": "integer", "default": 1 }
          }
        },
        "defaultFrameRate": { "type": "number", "default": 24 }
      }
    }
  }
}
